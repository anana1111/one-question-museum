<section class="experiment" aria-label="遮挡程度实验"><div class="experiment-top"><span>实验台 001 / OCCLUSION</span><span id="reliability" role="status">遮挡程度：0%</span></div><canvas id="skeleton" width="900" height="480" role="img" aria-label="人体骨架示意。增加遮挡后，下半身关键点偏离参考位置。">请使用支持 Canvas 的浏览器。</canvas><div class="controls"><label for="occlusion">遮挡程度 <output id="amount" for="occlusion">0%</output></label><input id="occlusion" type="range" min="0" max="100" value="0"/><div class="range-ends"><span>看得清</span><span>只能猜</span></div><button id="pause" type="button">暂停动画</button><p id="motion-note">实线：模拟识别 · 虚线：身体参考位置。拖动滑块，观察腿部。</p></div><p class="experiment-note">教学模拟，不是真实姿态模型；百分比仅表示遮挡强度，不表示识别准确率。</p></section>
<script>
const canvas=document.querySelector<HTMLCanvasElement>('#skeleton');
if(canvas){
 const ctx=canvas.getContext('2d')!; const slider=document.querySelector<HTMLInputElement>('#occlusion')!; const output=document.querySelector<HTMLOutputElement>('#amount')!; const button=document.querySelector<HTMLButtonElement>('#pause')!; const media=matchMedia('(prefers-reduced-motion: reduce)'); let paused=media.matches; let frame=0; let time=0;
 const points=[[450,80],[450,130],[365,150],[535,150],[325,225],[575,225],[305,290],[595,290],[405,260],[495,260],[395,345],[505,345],[380,425],[520,425]];const edges=[[0,1],[1,2],[1,3],[2,4],[3,5],[4,6],[5,7],[2,8],[3,9],[8,9],[8,10],[9,11],[10,12],[11,13]];
 function draw(){const level=Number(slider.value)/100;const color=getComputedStyle(canvas!).color;ctx.clearRect(0,0,900,480);ctx.strokeStyle=color;ctx.globalAlpha=.1;ctx.lineWidth=1;for(let x=50;x<900;x+=50){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,480);ctx.stroke()}for(let y=30;y<480;y+=50){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(900,y);ctx.stroke()}
 function lines(p:number[][],dashed:boolean){ctx.setLineDash(dashed?[5,8]:[]);ctx.lineWidth=dashed?2:3;ctx.beginPath();edges.forEach(([a,b])=>{ctx.moveTo(p[a][0],p[a][1]);ctx.lineTo(p[b][0],p[b][1])});ctx.stroke()}
 ctx.globalAlpha=.25;lines(points,true);ctx.globalAlpha=.08+level*.28;ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(385,240);ctx.lineTo(515,240);ctx.lineTo(560,405);ctx.lineTo(340,405);ctx.closePath();ctx.fill();
 const estimated=points.map(([x,y],i)=>i>=10?[x+Math.sin(time*2.3+i*3)*level*75,y+Math.cos(time*3.1+i*2)*level*55]:[x,y]);ctx.globalAlpha=1;ctx.strokeStyle=color;lines(estimated,false);estimated.forEach(([x,y],i)=>{ctx.fillStyle=i>=10&&level>.2?'#b85b36':color;ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fill()});ctx.setLineDash([]);ctx.font='14px sans-serif';ctx.fillStyle=color;ctx.globalAlpha=.65;ctx.fillText('身体被衣服遮住之后，模型看到了什么？',40,450);ctx.globalAlpha=1;}
 function tick(){time+=.035;draw();if(!paused&&!document.hidden)frame=requestAnimationFrame(tick)}
 function sync(){cancelAnimationFrame(frame);button.textContent=paused?'播放动画':'暂停动画';draw();if(!paused&&!document.hidden)frame=requestAnimationFrame(tick)}
 slider.addEventListener('input',()=>{output.value=slider.value+'%';document.querySelector('#reliability')!.textContent='遮挡程度：'+slider.value+'%';time+=.6;draw()});button.addEventListener('click',()=>{paused=!paused;sync()});media.addEventListener('change',()=>{paused=media.matches;sync()});document.addEventListener('visibilitychange',sync);if(media.matches)document.querySelector('#motion-note')!.textContent='已按系统偏好暂停动画。拖动滑块可查看静态变化；也可手动播放。';sync();
}
</script>
