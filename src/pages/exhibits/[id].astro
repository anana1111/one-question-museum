---
import Layout from '../../layouts/Layout.astro'; import Occlusion from '../../components/Occlusion.astro'; import {exhibits,href,outcomeNames} from '../../lib/museum';
export async function getStaticPaths(){const entries=(await exhibits()).filter(e=>e.data.status==='published');return entries.map((entry,i)=>({params:{id:entry.data.id},props:{entry,previous:entries[i-1],next:entries[i+1]}}))}
const {entry,previous,next}=Astro.props;const d=entry.data;
if(d.interaction!=='occlusion'&&d.interaction!=='none') throw new Error(`请为展品 ${d.id} 注册交互组件`);
---
<Layout title={`${d.title} · 一个问题的博物馆`} description={d.oneLiner}><a class="back" href={href()}>← 返回展厅</a><header class="exhibit-header"><span class="eyebrow">藏品 {d.id} / {d.hall}{d.demo?' / 示范展品':''}</span><h1>{d.title}</h1><dl class="spec"><div><dt>来自项目</dt><dd>{d.project}</dd></div><div><dt>卡住的日期</dt><dd>{d.date}{d.demo?'（占位）':''}</dd></div><div><dt>卡住时长</dt><dd>{d.stuckHours} 小时{d.demo?'（占位）':''}</dd></div><div><dt>结局</dt><dd>{outcomeNames[d.outcome]}{d.demo?'（占位）':''}</dd></div></dl>{d.demo&&<p class="notice">示范展品 · 日期、时长和结局为占位数据，不计入真实体验统计。</p>}</header><section class="story"><span>01 / 当时在做什么</span><p>{d.context}</p></section><section class="story"><span>02 / 卡在哪里</span><h2>{d.oneLiner}</h2></section><section class="interaction-section"><div class="section-head"><h2>03 / 动手体验</h2><span>把遮挡程度慢慢往右推</span></div>{d.interaction==='occlusion'?<Occlusion/>:<p class="notice">本件展品暂未配置交互。</p>}</section><section class="story"><span>04 / 最后怎么样了</span><p>{d.resolution}</p></section><nav class="pagination" aria-label="展品翻页">{previous?<a href={href(`exhibits/${previous.data.id}/`)}>← 上一件 · {previous.data.title}</a>:<span>这是第一件展品</span>}{next?<a href={href(`exhibits/${next.data.id}/`)}>下一件 · {next.data.title} →</a>:<a href={href()}>下一件正在筹展 · 返回展厅 →</a>}</nav></Layout>
