---
import '../styles/global.css';
import { href } from '../lib/museum';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; jsonLd?: Record<string, unknown> | Record<string, unknown>[]; noindex?: boolean }
const siteName = '一个问题的博物馆';
const { title = `${siteName} · ANNA 的个人问题博物馆`, description = '收藏亲手做东西时，真正推不动的那一下。独立网页开发者 ANNA 的个人主页：网页、剑道、视频与钓鱼中遇到的真实问题，做成可以动手体验的交互展品。', image = 'og.png', type = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(href(image), Astro.site).href;
const homeUrl = new URL(href(), Astro.site).href;
const baseLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, alternateName: 'The Museum of One Question', url: homeUrl, inLanguage: 'zh-CN', author: { '@type': 'Person', name: 'ANNA', jobTitle: '独立网页开发者' } };
const ld = [baseLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="color-scheme" content="light dark"/><title>{title}</title><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex"/>}<meta name="author" content="ANNA"/><meta property="og:site_name" content={siteName}/><meta property="og:type" content={type}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="一个问题的博物馆：做东西的时候，总有一下推不动。"/><meta property="og:locale" content="zh_CN"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/><link rel="sitemap" href={href('sitemap.xml')}/><script type="application/ld+json" set:html={JSON.stringify(ld)}/><link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/>
<script is:inline>try{const t=localStorage.getItem('museum-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch{}</script>
</head><body><a class="skip" href="#main">跳至内容</a><header class="site-header"><a class="brand" href={href()}>一个问题的博物馆<span>ANNA · 私人收藏 / 持续生长</span></a><nav aria-label="主导航"><a href={href()}>展厅</a><a href={href('projects/')}>项目索引</a><a href={href('unsolved/')}>未解决</a><a href={href('about/')}>关于</a><button id="theme" aria-label="切换浅色或深色模式">切换明暗</button></nav></header><main id="main"><slot/></main><footer><span>一个问题的博物馆</span><span>设计与开发 · ANNA</span><span>问题只属于亲手做过的人。</span></footer>
<script>document.querySelector('#theme')?.addEventListener('click',()=>{const root=document.documentElement;const dark=root.dataset.theme ? root.dataset.theme==='dark' : matchMedia('(prefers-color-scheme: dark)').matches;root.dataset.theme=dark?'light':'dark';try{localStorage.setItem('museum-theme',root.dataset.theme)}catch{}});</script>
</body></html>
